# Copy to .env for local development. .env is git-ignored — never commit real secrets.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=event_content
POSTGRES_USER=event_content
# Must match the password in src/EventContent.Api/appsettings.Development.json if you run the API outside Docker.
POSTGRES_PASSWORD=event_content_dev

# --- Development sign-in (temporary; replaced by OIDC later — see docs/adr/0002) ---
DEV_USER_EMAIL=owner@example.com

# --- Observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
